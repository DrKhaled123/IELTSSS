  "pronunciationTips": [
    {
      "id": 1,
      "title": "The 'Th' Sound (Voiced)",
      "category": "consonants",
      "tip": "Place your tongue lightly between your teeth and vibrate your vocal cords for 'this', 'that', 'the'.",
      "example": "This, That, The, Mother",
      "difficulty": "medium"
    },
    {
      "id": 2,
      "title": "The 'Th' Sound (Voiceless)",
      "category": "consonants",
      "tip": "Place tongue between teeth and blow air without voice for 'think', 'thank', 'thought'.",
      "example": "Think, Thank, Thought, Teeth",
      "difficulty": "medium"
    },
    {
      "id": 3,
      "title": "The Short 'i' vs Long 'ee'",
      "category": "vowels",
      "tip": "Short 'i' (bit) - mouth more open. Long 'ee' (beat) - mouth closed, lips spread wide.",
      "example": "Ship vs Sheep, Sit vs Seat",
      "difficulty": "easy"
    },
    {
      "id": 4,
      "title": "The 'R' Sound",
      "category": "consonants",
      "tip": "Curl your tongue slightly backward without touching the roof. English R is softer than many languages.",
      "example": "Red, Read, Right, Really",
      "difficulty": "hard"
    },
    {
      "id": 5,
      "title": "The 'L' Sound",
      "category": "consonants",
      "tip": "Touch the tip of your tongue to the ridge behind your upper teeth. Keep it there throughout.",
      "example": "Like, Light, Love, Long",
      "difficulty": "medium"
    },
    {
      "id": 6,
      "title": "Word Stress - Two Syllables",
      "category": "word_stress",
      "tip": "In English, usually stress the first syllable in nouns and the second in verbs.",
      "example": "CONduct (noun) vs conDUCT (verb)",
      "difficulty": "hard"
    },
    {
      "id": 7,
      "title": "Silent Letters",
      "category": "consonants",
      "tip": "Many English words have silent letters: knife (k), psychology (p), island (s), debt (b).",
      "example": "Knife, Knight, Thumb, Wednesday",
      "difficulty": "easy"
    },
    {
      "id": 8,
      "title": "Rising vs Falling Intonation",
      "category": "intonation",
      "tip": "Yes/No questions rise ↗ at the end. Statements fall ↘ at the end.",
      "example": "Are you ready?↗ vs I am ready.↘",
      "difficulty": "medium"
    },
    {
      "id": 9,
      "title": "Connected Speech - Linking",
      "category": "connected_speech",
      "tip": "Connect words ending in consonants to words starting with vowels: 'an apple' sounds like 'anapple'.",
      "example": "Pick it up → Pickit up",
      "difficulty": "hard"
    },
    {
      "id": 10,
      "title": "The Schwa /ə/ Sound",
      "category": "vowels",
      "tip": "The most common sound in English. It's a weak, lazy vowel sound. Relax your mouth completely.",
      "example": "About, Common, Problem, Support",
      "difficulty": "easy"
    }
  ],
